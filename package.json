{
  "name": "mr-chef",
  "private": true,
  "version": "0.1.0",
  "description": "Mr Chef : générateur de recettes par IA pour les robots Monsieur Cuisine (PWA local-first).",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @mr-chef/web dev",
    "build": "pnpm --filter @mr-chef/web build",
    "preview": "pnpm --filter @mr-chef/web preview",
    "relay:dev": "pnpm --filter @mr-chef/relay dev",
    "relay:deploy": "pnpm --filter @mr-chef/relay deploy",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @mr-chef/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "3.2.7"
  }
}
