{
  "name": "mr-chef",
  "private": true,
  "version": "0.1.0",
  "description": "Mr Chef : générateur de recettes par IA pour les robots Monsieur Cuisine (PWA local-first).",
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mr-chef/web",
    "build": "npm run build -w @mr-chef/web && npm run bundle -w @mr-chef/relay",
    "preview": "npm run preview -w @mr-chef/web",
    "relay:dev": "npm run dev -w @mr-chef/relay",
    "relay:deploy": "npm run deploy -w @mr-chef/relay",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @mr-chef/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.6"
    },
    "node-domexception": "file:./shims/node-domexception"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true
  }
}
